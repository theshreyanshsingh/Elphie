{
  "name": "dograh-server",
  "version": "1.37.0",
  "private": true,
  "type": "module",
  "description": "Express/Node backend migration target for Dograh",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "worker": "npm run build && node dist/src/tasks/worker.js",
    "migrate": "npm run build && node dist/src/migrations/run.js",
    "db:parity": "npm run build && node dist/src/migrations/compareSchema.js",
    "openapi:check": "npm run build && node dist/src/openapi/checkContract.js",
    "openapi:list": "npm run build && node dist/src/openapi/listRoutes.js",
    "parity:gate": "npm run build && node dist/src/openapi/checkContract.js && node dist/src/parity/checkPlaceholders.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.5",
    "minio": "^8.0.3",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.13",
    "node-mocks-http": "^1.17.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
